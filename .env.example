# .env.example - contains no real credentials. Copy to .env and fill in your own values.

# Which LLM to use: gemini (default), ollama (local backup) or none (AI off, rule fallbacks only)
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
# How much the model "thinks" before answering: low keeps each call around 5 seconds
GEMINI_THINKING=low

# Only needed when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Local SQLite database file (created automatically)
DATABASE_PATH=fridgemate.db

# TheMealDB test key "1" is free and public
MEALDB_API_KEY=1

# Web app address allowed to call the API
CORS_ORIGINS=http://localhost:5173
