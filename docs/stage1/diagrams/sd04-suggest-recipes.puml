@startuml sd04-suggest-recipes
title SD04: Suggest Recipes (F07, with F08 missing ingredients and F10 Quick Finder)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":RecipePage" as P
participant ":ApiClient" as A
boundary ":RecipeRouter" as R
control ":FridgemateFacade" as F
participant ":RecipeAgent" as RA <<AI agent>>
participant ":FridgeIngredientSource" as FIS
participant ":InventoryService" as IS
participant ":GeminiClient" as G
participant ":SearchRecipesTool" as SRT
participant ":MealDBRecipeSource" as MDB
participant "TheMealDB API" as API <<external>>
participant ":ValidateRecipeTool" as VRT
participant ":StockValidator" as SV
participant ":ResponseParser" as RS
participant ":AgentTrace" as AT

M -> P ++ : pick cuisine, time, weight, servings\n(or "Let AI decide"), Get recipes
P -> A ++ : suggestRecipes(request)
A -> R ++ : POST /recipes/suggest (token, request)
R -> F ++ : suggest_recipes(ctx, request)
F -> RA ++ : set_source(FridgeIngredientSource)
RA --> F --
F -> RA ++ : run(ctx, request)
RA -> FIS ++ : get_ingredients(ctx)
FIS -> IS ++ : get_items(ctx)
IS --> FIS -- : items
FIS -> FIS : keep own and Shared items where\ncan_use_in_recipe() is true
FIS --> RA -- : usable items, expiring and offered first
break no usable items
  RA --> F : empty result
  F --> R : suggestion to use Quick Finder or shopping list
end
loop until a final answer, at most 6 tool steps
  RA -> G ++ : generate_with_tools(prompt, declarations)
  G --> RA -- : tool call
  alt tool = search_recipes
    RA -> SRT ++ : execute(ctx, {ingredients, cuisine})
    SRT -> MDB ++ : search_by_ingredients(ingredients, cuisine)
    loop one request per ingredient (free key)
      MDB -> API ++ : GET /filter.php?i=ingredient
      API --> MDB -- : meals
    end
    MDB --> SRT -- : recipes
    SRT --> RA -- : candidate recipes
  else tool = validate_recipe
    RA -> VRT ++ : execute(ctx, {recipe})
    VRT -> SV ++ : validate(recipe, items)
    SV --> VRT -- : missing ingredients
    VRT --> RA -- : available, short, missing
  end
  RA -> AT ++ : record(step)
  AT --> RA --
end
RA -> RS ++ : parse(final_text, SuggestionSchema)
RS --> RA -- : suggestions with estimated time and\nweight, substitutes, AI choices
RA --> F -- : list[RecipeSuggestion]
F --> R -- : suggestions
R --> A -- : 200 OK
A --> P -- : suggestions
P --> M -- : up to 5 recipe cards with "Why this recipe?"

note over MDB, API : if TheMealDB is down, the agent writes a recipe itself,\nlabels it AI-generated, and still validates it with StockValidator
note over F, FIS : F10 Quick Finder: find_recipes() calls\nset_source(ManualIngredientSource) instead;\nevery other step is the same (Strategy)
@enduml
