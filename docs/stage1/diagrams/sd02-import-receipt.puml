@startuml sd02-import-receipt
title SD02: Import Receipt (F03)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":ReceiptImportPage" as P
participant ":ApiClient" as A
boundary ":ReceiptRouter" as R
control ":FridgemateFacade" as F
participant ":ReceiptParser" as RP
participant ":PromptBuilder" as PB
participant ":GeminiClient" as G
participant ":ResponseParser" as RS
participant ":PlacementService" as PS
participant ":ExpiryService" as ES
participant ":InventoryService" as IS

note over A, R : every request carries the member's token and passes\nTokenVerifier.current_context() first, as shown in SD01

M -> P ++ : upload receipt photo, pick who paid
P -> A ++ : importReceipt(photo)
A -> R ++ : POST /receipts (token, photo)
R -> F ++ : import_receipt(ctx, image)
F -> RP ++ : parse(image)
RP -> PB ++ : build("read_receipt", {})
PB --> RP -- : prompt (receipt text is data only)
RP -> G ++ : read_image(image, prompt)
G --> RP -- : text
RP -> RS ++ : parse(text, ReceiptSchema)
alt answer matches the schema
  RS --> RP : items
else malformed answer
  RS --> RP : ParseError
  RP -> G ++ : read_image(image, prompt)
  G --> RP -- : text (one retry)
  RP -> RS : parse(text, ReceiptSchema)
  RS --> RP : items or ParseError
end
deactivate RS
break photo unreadable or retry failed
  RP --> F : error
  F --> R : error
  R --> A : 422 error
  A --> P : error
  P --> M : "Couldn't read the receipt"
end
RP -> RP : drop non-food lines\n(bags, taxes, deposits)
RP --> F -- : items
loop for each item
  F -> PS ++ : suggest_location(item.name)
  PS --> F -- : (location, reason)
  F -> ES ++ : estimate_expiry(item.name, location, today)
  ES --> F -- : expiry_date
end
F --> R -- : proposed items
R --> A -- : 200 OK (items)
A --> P -- : items
P --> M -- : review popup

M -> P ++ : set owners, remove or add items, Save
alt all items removed
  P --> M : Save stays disabled
else at least one item
  P -> A ++ : request("POST", "/receipts/save", items, payer_id)
  A -> R ++ : POST /receipts/save
  R -> F ++ : save_receipt_items(ctx, items, payer_id)
  loop for each item
    F -> IS ++ : add(ctx, item)
    IS --> F -- : item
  end
  note right of F : no command is created,\nso imports have no undo
  F --> R -- : count
  R --> A -- : 201 Created
  A --> P -- : count
  P --> M : "12 items added"
end
deactivate P
@enduml
