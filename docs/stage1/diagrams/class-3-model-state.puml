@startuml class-3-model-state
title Fridgemate Class Diagram 3: Domain Model and State Pattern (server.domain.model)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
hide circle
set separator none

package "server.domain.model" {

  class Household {
    +id : UUID
    +name : str
    +invite_code : str
  }

  class Member {
    +id : UUID
    +auth0_id : str
    +name : str
    +email : str
    +dietary_restrictions : list[str]
    +disliked_ingredients : list[str]
    +allows(ingredient: str) : bool
  }

  class FoodItem {
    +id : UUID
    +name : str
    +quantity : Quantity
    +original_amount : float
    +location : Location
    +owner : Optional[Member]
    +is_offered : bool
    +offered_by : Optional[Member]
    +price : Optional[Decimal]
    +payer : Optional[Member]
    +added_on : date
    +expiry_date : date
    +expiry_estimated : bool
    -state : FreshnessState
    +refresh_state(today: date)
    +can_use_in_recipe() : bool
    +can_offer() : bool
    +alert_priority() : int
    +is_shared() : bool
    +is_low() : bool
  }

  class Quantity {
    +amount : float
    +unit : str
    +to(unit: str) : Quantity
  }

  enum Location <<enumeration>> {
    FRIDGE
    FREEZER
    PANTRY
  }

  interface FreshnessState <<interface>> {
    +can_use_in_recipe() : bool
    +can_offer() : bool
    +alert_priority() : int
    +label() : str
  }
  class FreshState {
    +can_use_in_recipe() : bool
    +can_offer() : bool
    +alert_priority() : int
    +label() : str
  }
  class ExpiringSoonState {
    +can_use_in_recipe() : bool
    +can_offer() : bool
    +alert_priority() : int
    +label() : str
  }
  class ExpiredState {
    +can_use_in_recipe() : bool
    +can_offer() : bool
    +alert_priority() : int
    +label() : str
  }

  class Recipe {
    +id : str
    +name : str
    +cuisine : str
    +instructions : str
    +source : str
    +estimated_minutes : Optional[int]
    +meal_weight : Optional[MealWeight]
  }

  class RecipeIngredient {
    +name : str
    +quantity : Quantity
  }

  class RecipeRequest {
    +cuisine : Optional[Cuisine]
    +cooking_time : Optional[CookingTime]
    +meal_weight : Optional[MealWeight]
    +servings : Optional[int]
    +open_choices() : list[str]
  }

  enum Cuisine <<enumeration>> {
    ITALIAN
    INDIAN
    CHINESE
    MEXICAN
    ...
  }

  enum CookingTime <<enumeration>> {
    UNDER_15
    FROM_15_TO_30
    FROM_30_TO_60
    OVER_60
  }

  enum MealWeight <<enumeration>> {
    LIGHT
    MEDIUM
    HEAVY
  }

  class RecipeSuggestion {
    +recipe : Recipe
    +used_items : list[FoodItem]
    +missing : list[RecipeIngredient]
    +substitutes : dict[str, str]
    +ai_choices : dict[str, str]
    +explanation : str
    +score : float
  }

  class MealPlan {
    +id : UUID
    +created_on : date
    +days : int
    +meals_per_day : int
    +needs_update : bool
    +check_against(items: list[FoodItem]) : bool
  }

  class PlannedMeal {
    +day : date
    +slot : int
    +item_ids : list[UUID]
  }

  class ShoppingList {
    +add(item: ShoppingListItem)
    +check(item_id: UUID)
  }

  class ShoppingListItem {
    +id : UUID
    +name : str
    +quantity : Quantity
    +section : str
    +reason : str
    +shared : bool
  }

  class Settlement {
    +from_member : Member
    +to_member : Member
    +amount : Decimal
    +paid : bool
  }

  class Notification {
    +id : UUID
    +message : str
    +item_id : Optional[UUID]
    +created_at : datetime
    +read : bool
  }
}

Household "1" o-- "1..*" Member : members
Household "1" *-- "0..*" FoodItem : inventory
FoodItem "0..*" --> "0..1" Member : owner
FoodItem "0..*" --> "0..1" Member : payer
FoodItem "0..*" --> "0..1" Member : offered_by
FoodItem "1" *-- "1" Quantity
FoodItem "0..*" --> "1" Location
FoodItem "0..*" o-- "1" FreshnessState : state

FreshnessState <|.. FreshState
FreshnessState <|.. ExpiringSoonState
FreshnessState <|.. ExpiredState

Recipe "1" *-- "1..*" RecipeIngredient : ingredients
RecipeIngredient "1" *-- "1" Quantity
RecipeRequest "0..*" --> "0..1" Cuisine
RecipeRequest "0..*" --> "0..1" CookingTime
RecipeRequest "0..*" --> "0..1" MealWeight
Recipe "0..*" --> "0..1" MealWeight
RecipeSuggestion "0..*" --> "1" Recipe
RecipeSuggestion "0..*" --> "0..*" FoodItem : used_items
RecipeSuggestion "0..*" --> "0..*" RecipeIngredient : missing

Member "1" --> "0..*" MealPlan : plans
MealPlan "1" *-- "1..*" PlannedMeal : meals
PlannedMeal "0..*" --> "1" Recipe

Member "1" --> "1" ShoppingList : list
ShoppingList "1" *-- "0..*" ShoppingListItem : items
ShoppingListItem "1" *-- "1" Quantity
Household "1" *-- "0..*" Settlement : payments
Settlement "0..*" --> "1" Member : from_member
Settlement "0..*" --> "1" Member : to_member
Member "1" --> "0..*" Notification : inbox

note right of FreshnessState
  <b>State pattern</b>
  Context: FoodItem
  State: FreshnessState
  Concrete states: FreshState,
  ExpiringSoonState, ExpiredState
  FoodItem.refresh_state() picks the state
  from the expiry date (Expiring soon =
  within 3 days); the item then delegates
  can_use_in_recipe(), can_offer(),
  alert_priority() and label() to it.
end note

note bottom of FoodItem
  owner = None means the item is Shared.
end note

note bottom of RecipeRequest
  A field set to None means
  "Let AI decide".
end note
@enduml
