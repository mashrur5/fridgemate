@startuml sd06-shopping-list
title SD06: Build Shopping List (F11)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":RecipePage" as RPG
boundary ":ShoppingListPage" as SP
participant ":ApiClient" as A
boundary ":ShoppingRouter" as R
control ":FridgemateFacade" as F
participant ":ShoppingListService" as SLS
participant ":GeminiClient" as G
participant ":UnitConverter" as UC
participant ":ShoppingListRepository" as SLR

M -> RPG ++ : "Add missing to shopping list"
RPG -> A ++ : request("POST", "/shopping", ingredients)
A -> R ++ : POST /shopping (token, ingredients)
R -> F ++ : add_to_shopping_list(ctx, ingredients)
F -> SLS ++ : add_missing(ctx, ingredients)
SLS -> SLR ++ : find_for_member(member_id)
SLR --> SLS -- : shopping_list
SLS -> G ++ : generate(prompt with new and existing names)
alt Gemini answers
  G --> SLS : matching names and store sections
else Gemini unavailable
  G --> SLS : error
  SLS -> SLS : match exact names only, no sections
end
deactivate G
loop for each matched pair
  SLS -> UC ++ : convert(quantity, existing.unit)
  alt units can be converted
    UC --> SLS : quantity
    SLS -> SLS : merge amounts ("200 g" + "1 kg" = "1.2 kg")
  else units can't be converted
    UC --> SLS : error
    SLS -> SLS : keep both lines under the same item
  end
  deactivate UC
end
SLS -> SLR ++ : save(shopping_list)
SLR --> SLS --
SLS --> F --
F --> R -- : ok
R --> A -- : 200 OK
A --> RPG --
RPG --> M -- : "Added to shopping list"

M -> SP ++ : open Shopping List page
SP -> A ++ : request("GET", "/shopping")
A -> R ++ : GET /shopping (token)
R -> F ++ : build_shopping_list(ctx)
F -> SLS ++ : build_shopping_list(ctx)
SLS -> SLR ++ : find_for_member(member_id)
SLR --> SLS -- : shopping_list
SLS --> F -- : shopping_list
F --> R -- : shopping_list
R --> A -- : 200 OK
A --> SP -- : shopping_list
SP --> M -- : list grouped by section, with reasons

note over SLS, UC : items that run low arrive through\nShoppingListService.update(item, change),\nthe Observer call shown in SD05
@enduml
