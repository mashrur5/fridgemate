@startuml class-1-overview
title Fridgemate Class Diagram 1: Overview of Tiers, Layers and Packages
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
hide circle
set separator none

package "Client tier" {
  package "Presentation" as L1 {
    package "web (React, TypeScript)" as web {
      class App
      class "11 pages" as Pages
    }
    package "cli (Python)" as cli {
      class FridgemateCLI
    }
  }
  package "Client gateway" as L2 {
    class ApiClient
    class FridgemateClient
    class "Auth0 login\n(React SDK, DeviceLogin)" as Login
  }
}

package "Server tier (FastAPI on Render)" {
  package "API layer: server.api" as L3 {
    class "10 routers" as Routers
    class TokenVerifier
  }
  package "Application layer: server.application" as L4 {
    class FridgemateFacade
    class RequestContext
  }
  package "Domain and Agent layer" as L5 {
    package "server.domain.model" as model {
    }
    package "server.domain.services" as services {
    }
    package "server.domain.commands" as commands {
    }
    package "server.agent" as agent {
    }
    package "server.agent.tools" as tools {
    }
  }
  package "Infrastructure layer" as L6 {
    package "server.infrastructure.persistence" as persistence {
    }
    package "server.infrastructure.llm" as llm {
    }
    package "server.infrastructure.recipes" as recipes {
    }
    package "server.infrastructure.auth" as auth {
    }
  }
}

package "External services" <<Cloud>> {
  class "Neon PostgreSQL" as Neon
  class "Google Gemini" as Gemini
  class "TheMealDB" as MealDB
  class "Auth0" as Auth0
}

App ..> Pages
Pages ..> ApiClient
FridgemateCLI ..> FridgemateClient
ApiClient ..> Login
FridgemateClient ..> Login
ApiClient ..> Routers : HTTPS
FridgemateClient ..> Routers : HTTPS
Routers ..> TokenVerifier
Routers ..> FridgemateFacade
FridgemateFacade ..> services
FridgemateFacade ..> commands
FridgemateFacade ..> agent
agent ..> tools
tools ..> services
agent ..> model
services ..> model
commands ..> services
services ..> persistence : through interfaces
services ..> llm : through LLMClient
agent ..> llm : through LLMClient
tools ..> recipes : through RecipeSource
TokenVerifier ..> auth
persistence ..> Neon
llm ..> Gemini
recipes ..> MealDB
auth ..> Auth0
Login ..> Auth0

note right of L5
  Business rules (ownership, household,
  expiry) live here, in regular code.
  Agents reach data only through tools,
  and tools only call services.
end note

note right of L6
  Layer 5 depends on interfaces
  (ItemRepository, LLMClient, RecipeSource);
  layer 6 implements them
  (Dependency Inversion).
end note
@enduml