@startuml sd09-split-costs
title SD09: Split Shared Costs (F14)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":CostSplitPage" as P
participant ":ApiClient" as A
boundary ":CostRouter" as R
control ":FridgemateFacade" as F
participant ":CostSplitService" as CSS
participant ":ItemRepository" as IR
participant ":SettlementRepository" as SR

M -> P ++ : open Cost Split, pick a period
P -> A ++ : request("GET", "/costs", start, end)
A -> R ++ : GET /costs (token)
R -> F ++ : split_costs(ctx, start, end)
F -> CSS ++ : split(ctx, start, end)
CSS -> IR ++ : find_by_household(household_id)
IR --> CSS -- : items
CSS -> SR ++ : find_by_household(household_id)
SR --> CSS -- : recorded payments
CSS -> CSS : keep Shared items in the period that\nhave a price and were not offered (F15)
alt only one member
  CSS --> F : nothing to split
else two or more members
  CSS -> CSS : split each cost equally,\nbalance = paid - share - payments made
  CSS -> CSS : match the biggest debtor with the\nbiggest creditor until all settle,\nextra cents go to the payer
  CSS --> F : list[Settlement], items missing a price
end
deactivate CSS
F --> R -- : summary
R --> A -- : 200 OK
A --> P -- : summary
P --> M -- : balances, suggested payments,\n"Missing price" list

M -> P ++ : Mark as paid
P -> A ++ : request("POST", "/costs/paid", settlement_id)
A -> R ++ : POST /costs/paid (token)
R -> F ++ : mark_paid(ctx, settlement_id)
F -> CSS ++ : mark_paid(ctx, settlement)
CSS -> SR ++ : save(settlement)
SR --> CSS --
CSS --> F --
F --> R --
R --> A -- : 200 OK
A --> P --
P --> M -- : recalculated balances
@enduml
