@startuml class-5-commands
title Fridgemate Class Diagram 5: Command Pattern (server.domain.commands)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
hide circle
set separator none

package "server.domain.commands" {
  interface InventoryCommand <<interface>> {
    +execute()
    +undo()
  }
  class AddItemCommand {
    -item : FoodItem
    +execute()
    +undo()
  }
  class UpdateItemCommand {
    -item : FoodItem
    -before : FoodItem
    +execute()
    +undo()
  }
  class RemoveItemCommand {
    -item_id : UUID
    -removed : FoodItem
    +execute()
    +undo()
  }
  class CookRecipeCommand {
    -deductions : list[tuple[UUID, Quantity]]
    -leftover : Optional[FoodItem]
    +execute()
    +undo()
  }
  class OfferItemCommand {
    -item_id : UUID
    -note : str
    +execute()
    +undo()
  }
  class ClaimItemCommand {
    -item_id : UUID
    -claimer_id : UUID
    +execute()
    +undo()
  }
  class CommandHistory {
    -history : dict[UUID, list[InventoryCommand]]
    +run(ctx: RequestContext, command: InventoryCommand)
    +undo_last(ctx: RequestContext) : bool
  }
  class ProposedChanges {
    +commands : list[InventoryCommand]
    +summary : list[str]
  }
}


class InventoryService <<receiver, see Diagram 4>>
class FridgemateFacade <<client, see Diagram 2>>
class CookingService <<see Diagram 4>>
class FridgeCommandAgent <<see Diagram 6>>

InventoryCommand <|.. AddItemCommand
InventoryCommand <|.. UpdateItemCommand
InventoryCommand <|.. RemoveItemCommand
InventoryCommand <|.. CookRecipeCommand
InventoryCommand <|.. OfferItemCommand
InventoryCommand <|.. ClaimItemCommand
CommandHistory "1" o-- "0..*" InventoryCommand : history
ProposedChanges "1" o-- "1..*" InventoryCommand : commands

AddItemCommand "0..*" --> "1" InventoryService : receiver
UpdateItemCommand "0..*" --> "1" InventoryService : receiver
RemoveItemCommand "0..*" --> "1" InventoryService : receiver
CookRecipeCommand "0..*" --> "1" InventoryService : receiver
OfferItemCommand "0..*" --> "1" InventoryService : receiver
ClaimItemCommand "0..*" --> "1" InventoryService : receiver

FridgemateFacade "1" --> "1" CommandHistory : invokes
FridgemateFacade ..> InventoryCommand : creates Add, Update,\nRemove, Offer, Claim
CookingService ..> CookRecipeCommand : creates
FridgeCommandAgent ..> ProposedChanges : creates

note right of CommandHistory
  <b>Command pattern</b>
  Command: InventoryCommand
  Concrete commands: AddItemCommand,
  UpdateItemCommand, RemoveItemCommand,
  CookRecipeCommand, OfferItemCommand,
  ClaimItemCommand
  Invoker: CommandHistory (one undo
  stack per member, kept in memory)
  Receiver: InventoryService
  Client: FridgemateFacade
  Each command stores what it needs
  for undo(), e.g. RemoveItemCommand
  keeps the removed item.
  Withdrawing an F15 offer runs
  OfferItemCommand.undo(). Claims are
  final, so ClaimItemCommand is not
  added to the undo history.
end note
@enduml