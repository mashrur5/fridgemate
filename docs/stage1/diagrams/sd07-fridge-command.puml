@startuml sd07-fridge-command
title SD07: Run Natural-Language Fridge Command (F12)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":CommandChatPage" as P
participant ":ApiClient" as A
boundary ":CommandRouter" as R
control ":FridgemateFacade" as F
participant ":FridgeCommandAgent" as FCA <<AI agent>>
participant ":ConversationMemory" as CM
participant ":GeminiClient" as G
participant ":GetInventoryTool" as GIT
participant ":ProposeInventoryChangeTool" as PIT
participant ":CommandHistory" as CH
participant ":InventoryCommand" as IC
participant ":InventoryService" as IS

M -> P ++ : "I finished the milk, add 6 eggs"
P -> A ++ : request("POST", "/commands", message)
A -> R ++ : POST /commands (token, message)
R -> F ++ : run_command(ctx, message)
F -> FCA ++ : run(ctx, message)
FCA -> CM ++ : recent()
CM --> FCA -- : earlier turns
FCA -> G ++ : generate_with_tools(prompt, declarations)
G --> FCA -- : call get_inventory("milk", "eggs")
FCA -> GIT ++ : execute(ctx, {names})
GIT --> FCA -- : matching items
alt a name matches more than one item
  FCA --> F : clarifying question ("Which milk?")
else every item is clear
  FCA -> G ++ : generate_with_tools(prompt, declarations)
  G --> FCA -- : call propose_inventory_change(changes)
  loop for each change
    FCA -> PIT ++ : execute(ctx, change)
    PIT -> PIT : check the item exists, the member may\nchange it, the quantity and unit are valid
    PIT --> FCA -- : valid change, or reason it was left out
  end
  create ":ProposedChanges" as PC
  FCA -> PC : <<create>> (Add, Update and Remove commands, summary)
  FCA -> CM ++ : add(role, text)
  CM --> FCA --
  FCA --> F : ProposedChanges
end
deactivate FCA
F --> R -- : proposed changes or question
R --> A -- : 200 OK
A --> P -- : result
P --> M -- : card with Confirm and Cancel, or the question

M -> P ++ : Confirm
P -> A ++ : request("POST", "/commands/confirm", changes)
A -> R ++ : POST /commands/confirm (token)
R -> F ++ : confirm_changes(ctx, changes)
loop for each command in changes.commands
  F -> CH ++ : run(ctx, command)
  CH -> IC ++ : execute()
  IC -> IS ++ : add(ctx, item), update(ctx, item)\nor remove(ctx, item_id)
  IS --> IC --
  IC --> CH --
  CH --> F --
end
F --> R -- : summary
R --> A -- : 200 OK
A --> P -- : summary
P --> M -- : updated inventory with Undo button
note over P, A : if the member presses Cancel,\nno request is sent and nothing changes
@enduml
