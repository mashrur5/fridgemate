@startuml class-2-clients-api
title Fridgemate Class Diagram 2: Clients, API and Facade (web, cli, server.api, server.application)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
hide circle
set separator none
left to right direction

package "web (React, TypeScript)" {
  class App
  class ProfileSetupPage
  class HouseholdPage
  class InventoryPage
  class NotificationsPage
  class ReceiptImportPage
  class RecipePage
  class QuickFinderPage
  class MealPlanPage
  class ShoppingListPage
  class CostSplitPage
  class CommandChatPage
  class ApiClient {
    -baseUrl : string
    +request(method: string, path: string, body?: object) : Promise<object>
    +getItems(filters: object) : Promise<FoodItem[]>
    +importReceipt(photo: File) : Promise<FoodItem[]>
    +suggestRecipes(request: RecipeRequest) : Promise<RecipeSuggestion[]>
    +offerItem(itemId: string, note: string) : Promise<void>
  }
  class "Auth0 React SDK" as Auth0Sdk <<library>>
}

package "cli (Python)" {
  class FridgemateCLI {
    +items(action: str)
    +receipt_import(photo: Path)
    +recipes_suggest(cuisine: str, time: str, weight: str, servings: int)
    +cook(recipe_id: str, servings: int, leftovers: int)
    +do(message: str)
    +plan(days: int)
    +offer(item: str)
    +login()
    +logout()
  }
  class FridgemateClient {
    -base_url : str
    +request(method: str, path: str, body: Optional[dict]) : dict
  }
  class DeviceLogin {
    -auth0_domain : str
    -client_id : str
    +login() : str
  }
  class TokenStore {
    +save(token: str)
    +load() : Optional[str]
    +clear()
  }
}

package "server.api" {
  class TokenVerifier {
    -auth : Auth0Client
    +verify(token: str) : dict
    +current_context(token: str) : RequestContext
  }
  class AccountRouter
  class HouseholdRouter
  class InventoryRouter
  class ReceiptRouter
  class RecipeRouter
  class MealPlanRouter
  class ShoppingRouter
  class CostRouter
  class CommandRouter
  class NotificationRouter
}

package "server.application" {
  class RequestContext {
    +member : Member
    +household : Household
  }
  class FridgemateFacade {
    +set_profile(ctx: RequestContext, name: str) : Member
    +update_preferences(ctx: RequestContext, restrictions: list[str], dislikes: list[str]) : Member
    +request_password_reset(ctx: RequestContext)
    +create_household(ctx: RequestContext, name: str) : Household
    +join_household(ctx: RequestContext, invite_code: str) : Household
    +get_items(ctx: RequestContext, filters: dict) : list[FoodItem]
    +add_item(ctx: RequestContext, item: FoodItem) : FoodItem
    +update_item(ctx: RequestContext, item: FoodItem) : FoodItem
    +remove_item(ctx: RequestContext, item_id: UUID)
    +suggest_location(item_name: str) : tuple[Location, str]
    +import_receipt(ctx: RequestContext, image: bytes) : list[FoodItem]
    +save_receipt_items(ctx: RequestContext, items: list[FoodItem], payer_id: UUID) : int
    +get_alerts(ctx: RequestContext) : list[FoodItem]
    +suggest_recipes(ctx: RequestContext, request: RecipeRequest) : list[RecipeSuggestion]
    +find_recipes(ctx: RequestContext, names: list[str], request: RecipeRequest) : list[RecipeSuggestion]
    +cook_recipe(ctx: RequestContext, recipe: Recipe, servings: int, amounts: dict[UUID, Quantity], leftovers: int)
    +undo(ctx: RequestContext) : bool
    +run_command(ctx: RequestContext, message: str) : ProposedChanges
    +confirm_changes(ctx: RequestContext, changes: ProposedChanges)
    +plan_meals(ctx: RequestContext, days: int, meals_per_day: int, max_time: CookingTime) : MealPlan
    +replan_meals(ctx: RequestContext) : MealPlan
    +build_shopping_list(ctx: RequestContext) : ShoppingList
    +add_to_shopping_list(ctx: RequestContext, ingredients: list[RecipeIngredient])
    +split_costs(ctx: RequestContext, start: date, end: date) : list[Settlement]
    +mark_paid(ctx: RequestContext, settlement_id: UUID)
    +offer_item(ctx: RequestContext, item_id: UUID, note: str)
    +withdraw_offer(ctx: RequestContext, item_id: UUID)
    +claim_item(ctx: RequestContext, item_id: UUID) : bool
    +get_notifications(ctx: RequestContext) : list[Notification]
  }
}

package "Subsystem behind the facade (Diagrams 4 to 6)" {
  class InventoryService
  class HouseholdService
  class AccountService
  class PlacementService
  class ExpiryService
  class CookingService
  class ShoppingListService
  class CostSplitService
  class NotificationService
  class ExpiryAlertNotifier
  class CommandHistory
  class RecipeAgent
  class MealPlanAgent
  class FridgeCommandAgent
  class ReceiptParser
}

class Auth0Client <<see Diagram 7>>

