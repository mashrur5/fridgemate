DeviceLogin "1" --> "1" TokenStore
FridgemateClient "1" --> "1" TokenStore
FridgemateClient ..> "server.api" : HTTPS + token

AccountRouter "1" --> "1" FridgemateFacade
HouseholdRouter "1" --> "1" FridgemateFacade
InventoryRouter "1" --> "1" FridgemateFacade
ReceiptRouter "1" --> "1" FridgemateFacade
RecipeRouter "1" --> "1" FridgemateFacade
MealPlanRouter "1" --> "1" FridgemateFacade
ShoppingRouter "1" --> "1" FridgemateFacade
CostRouter "1" --> "1" FridgemateFacade
CommandRouter "1" --> "1" FridgemateFacade
NotificationRouter "1" --> "1" FridgemateFacade
