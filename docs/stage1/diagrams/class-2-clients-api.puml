App "1" *-- "1" HouseholdPage
App "1" *-- "1" InventoryPage
App "1" *-- "1" NotificationsPage
App "1" *-- "1" ReceiptImportPage
App "1" *-- "1" RecipePage
App "1" *-- "1" QuickFinderPage
App "1" *-- "1" MealPlanPage
App "1" *-- "1" ShoppingListPage
App "1" *-- "1" CostSplitPage
App "1" *-- "1" CommandChatPage
App "1" --> "1" Auth0Sdk
App "1" --> "1" ApiClient
