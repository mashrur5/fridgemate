@startuml sd03-expiry-alerts
title SD03: Refresh Freshness and Show Alerts (F05, with the F04 State pattern)
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox

actor "Member" as M
boundary ":InventoryPage" as P
participant ":ApiClient" as A
boundary ":InventoryRouter" as R
control ":FridgemateFacade" as F
participant ":ExpiryAlertNotifier" as EA
participant ":InventoryService" as IS
participant ":ItemRepository" as IR
entity ":FoodItem" as FI
entity ":FreshnessState" as FS

M -> P ++ : log in or open "Use it first"
P -> A ++ : request("GET", "/alerts")
A -> R ++ : GET /alerts (token)
R -> F ++ : get_alerts(ctx)
F -> EA ++ : get_alerts(ctx)
EA -> IS ++ : get_items(ctx)
IS -> IR ++ : find_by_household(household_id)
IR --> IS -- : items
loop for each item
  IS -> FI ++ : refresh_state(today)
  FI -> FI : pick FreshState, ExpiringSoonState\nor ExpiredState from expiry_date
  FI --> IS --
end
IS --> EA -- : items
loop for each item the member owns, or Shared
  EA -> FI ++ : alert_priority()
  FI -> FS ++ : alert_priority()
  FS --> FI -- : priority
  FI --> EA -- : priority
end
EA -> EA : sort expiring items by days left,\nlist expired items separately
EA --> F -- : alerts
F --> R -- : alerts
R --> A -- : 200 OK (alerts)
A --> P -- : alerts
alt nothing expiring
  P --> M : "Nothing is expiring soon", no banner
else items expiring
  P --> M : banner with count, sorted list,\nOffer button on expiring items
end
deactivate P
note over EA, IS : when the inventory changes, InventoryService calls\nExpiryAlertNotifier.update(item, change) (Observer, see SD01)
@enduml
