@startuml usecase-diagram
title Fridgemate Use-Case Diagram
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction
skinparam nodesep 18
skinparam ranksep 90

actor "Household Member" as Member

rectangle "Fridgemate" {
  usecase "UC01 Manage Inventory Item\n--\n<i>extension point:</i>\nlocation or expiry left empty" as UC01
  usecase "UC02 Suggest Storage Location" as UC02
  usecase "UC03 Import Receipt" as UC03
  usecase "UC04 Estimate Expiry" as UC04
  usecase "UC05 View Expiry Alerts\n--\n<i>extension point:</i>\nitem expiring soon" as UC05
  usecase "UC06 Manage Household\nand Preferences" as UC06
  usecase "UC07 Get Recipe Suggestions\n--\n<i>extension point:</i>\nuser picks a recipe to cook" as UC07
  usecase "UC08 Check Missing Ingredients" as UC08
  usecase "UC09 Cook Recipe" as UC09
  usecase "UC10 Find Recipes by Ingredients" as UC10
  usecase "UC11 Generate Shopping List" as UC11
  usecase "UC12 Issue Natural-Language Command" as UC12
  usecase "UC13 Plan Waste-Rescue Meals\n--\n<i>extension point:</i>\nuser cooks a planned meal" as UC13
  usecase "UC14 Split Shared Costs" as UC14
  usecase "UC15 Offer and Claim Expiring Item" as UC15
  usecase "UC16 Manage Account" as UC16
}

actor "Gemini LLM\n<<AI service>>" as Gemini
actor "TheMealDB\n<<external API>>" as MealDB
actor "Auth0\n<<external service>>" as Auth0

' Primary actor
Member -- UC01
Member -- UC03
Member -- UC05
Member -- UC06
Member -- UC07
Member -- UC10
Member -- UC11
Member -- UC12
Member -- UC13
Member -- UC14
Member -- UC15
Member -- UC16

' include: always part of the base use case
UC03 ..> UC02 : <<include>>
UC03 ..> UC04 : <<include>>
UC07 ..> UC08 : <<include>>
UC10 ..> UC08 : <<include>>
UC13 ..> UC08 : <<include>>

' extend: optional behaviour added at an extension point
UC02 .[norank].> UC01 : <<extend>>
UC04 .[norank].> UC01 : <<extend>>
UC09 .[norank].> UC07 : <<extend>>
UC09 .[norank].> UC13 : <<extend>>
UC15 .[norank].> UC05 : <<extend>>

' Secondary actors
UC02 -- Gemini
UC03 -- Gemini
UC04 -- Gemini
UC07 -- Gemini
UC08 -- Gemini
UC10 -- Gemini
UC11 -- Gemini
UC12 -- Gemini
UC13 -- Gemini
UC07 -- MealDB
UC10 -- MealDB
UC13 -- MealDB
UC16 -- Auth0
@enduml